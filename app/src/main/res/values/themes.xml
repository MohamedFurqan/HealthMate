<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.HealthMate" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/healthmate_primary</item>
        <item name="colorPrimaryVariant">@color/healthmate_primary_dark</item>
        <item name="colorOnPrimary">@color/text_white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/healthmate_accent</item>
        <item name="colorSecondaryVariant">@color/healthmate_accent</item>
        <item name="colorOnSecondary">@color/text_white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/healthmate_primary_dark</item>
    </style>
</resources>